{
	"name": "tab-manager-extenstion",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:worker": "vite build --config src/worker/vite.config.ts",
		"build:watch": "vite build --watch",
		"build:watch:worker": "vite build --watch --config src/worker/vite.config.ts",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tsconfig/svelte": "^5.0.6",
		"@types/chrome": "^0.0.268",
		"@types/node": "^24.10.1",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"typescript": "~5.9.3",
		"vite": "^7.2.4"
	}
}
