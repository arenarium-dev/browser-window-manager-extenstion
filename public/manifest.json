{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"manifest_version": 3,
	"name": " ",
	"version": "1.0.0",
	"description": "View and store your windows, tabs, and tab groups as workspaces, stored in bookmarks",
	"permissions": ["bookmarks", "tabs", "tabGroups", "sidePanel", "alarms", "storage"],
	"action": {
		"default_title": "Workspaces"
	},
	"side_panel": {
		"default_path": "index.html"
	},
	"background": {
		"service_worker": "worker.js"
	},
	"icons": {
		"16": "icon.png",
		"32": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	}
}
