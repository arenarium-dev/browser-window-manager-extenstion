{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"manifest_version": 3,
	"name": "Tab Manager",
	"version": "1.0.0",
	"description": "View and manage your windows, tabs, and tab groups",
	"permissions": ["bookmarks", "tabs", "tabGroups", "sidePanel"],
	"action": {
		"default_title": "Tab Manager"
	},
	"side_panel": {
		"default_path": "index.html"
	},
	"background": {
		"service_worker": "worker.js"
	}
}
